ENVIRONMENT=local

DATABASE_JDBC_BASE_URL=jdbc:postgresql://localhost:5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_DRIVER_CLASS_NAME=org.postgresql.Driver
DATABASE_MAXIMUM_POOL_SIZE=10
DATABASE_MINIMUM_IDLE=5
DATABASE_AUTO_COMMIT=false
DATABASE_TRANSACTION_ISOLATION=TRANSACTION_REPEATABLE_READ

REDIS_HOST=localhost
REDIS_PORT=6379

SERVICES_GATEWAY_DOMAIN=http://localhost
SERVICES_AUTH_DOMAIN=http://localhost
SERVICES_ACCOUNT_DOMAIN=http://localhost
SERVICES_CATALOG_DOMAIN=http://localhost
SERVICES_INVOICE_DOMAIN=http://localhost
SERVICES_GATEWAY_PORT=8080
SERVICES_AUTH_PORT=8081
SERVICES_ACCOUNT_PORT=8082
SERVICES_CATALOG_PORT=8083
SERVICES_INVOICE_PORT=8084

AUTH_USER_CLIENT_ID=user
AUTH_USER_CLIENT_SECRET=dev-secret-user
AUTH_SERVICE_CLIENT_ID=service
AUTH_SERVICE_CLIENT_SECRET=dev-secret-service

OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
